  def apply_mode(mode)
    if mode == self.MODE_1LANE_1288x728_30
      self.width = 1288
      self.height = 728
      self.lane_num = 1
      self.mipi_clock = 400
      self.fps = 30
      self.format = 1
      self.res_index = self.MODE_1LANE_1288x728_30
      return self.write_array(self.ov02c10_input_24M_MIPI_1lane_raw10_1288x728_30fps(), true)
    elif mode == self.MODE_1LANE_1920x1080_30
      self.width = 1920
      self.height = 1080
      self.lane_num = 1
      self.mipi_clock = 408
      self.fps = 30
      self.format = 1
      self.res_index = self.MODE_1LANE_1920x1080_30
      return self.write_array(self.ov02c10_input_24M_MIPI_1lane_raw10_1920x1080_30fps(), true)
    end
    self.width = 1920
    self.height = 1080
    self.lane_num = 2
    self.mipi_clock = 408
    self.fps = 30
    self.format = 1
    self.res_index = self.MODE_2LANE_1920x1080_30
    return self.write_array(self.ov02c10_input_24M_MIPI_2lane_raw10_1920x1080_30fps(), true)
  end
  def choose_mode(idx)
    var mode = self.MODE_2LANE_1920x1080_30
    if idx == 0 return mode end
    import introspect
    var p = introspect.toptr(idx)
    var b = bytes(p, 28)
    var req_w = b.get(0, 2)
    var req_h = b.get(2, 2)
    var req_lane = b[9]
    var req_fps = b[17]
    var req_res = b[26]
    if req_res == self.MODE_1LANE_1288x728_30
      return self.MODE_1LANE_1288x728_30
    elif req_res == self.MODE_1LANE_1920x1080_30
      return self.MODE_1LANE_1920x1080_30
    elif req_res == self.MODE_2LANE_1920x1080_30
      return self.MODE_2LANE_1920x1080_30
    elif req_res == 255
      if req_w == 1288 && req_h == 728 && req_fps == 30
        return self.MODE_1LANE_1288x728_30
      elif req_w == 1920 && req_h == 1080 && req_fps == 30
        return req_lane == 1 ? self.MODE_1LANE_1920x1080_30 : self.MODE_2LANE_1920x1080_30
      end
    end
    return mode
  end
  def fill_config(idx)
    if idx == 0 return end
    import introspect
    var p = introspect.toptr(idx)
    var b = bytes(p, 28)
    b.set(0, self.width, 2)
    b.set(2, self.height, 2)
    b.set(4, 1920, 2)
    b.set(6, 1080, 2)
    b[8] = self.format
    b[9] = self.lane_num
    b.set(10, self.mipi_clock, 2)
    b.set(12, 0, 2)
    b.set(14, 0, 2)
    b[16] = 1
    b[17] = self.fps
    b.setbytes(18, bytes().fromstring("OV02C10"))
    b[26] = self.res_index
    b[27] = 0
  end
  def camera(cmd, idx, payload, raw)
    if cmd == "init"
      if !self.is_initialized
        if !self.detect() return 0 end
        self.is_initialized = true
      end
      if !self.write_array(self.ov02c10_mipi_reset_regs(), false) return 0 end
      var mode = self.choose_mode(idx)
      if !self.apply_mode(mode) return 0 end
      self.fill_config(idx)
      print(format("OV02C10: mode=%d %dx%d raw10 %dlane %dMbps %dfps", self.res_index, self.width, self.height, self.lane_num, self.mipi_clock, self.fps))
      return 1
    elif cmd == "stream"
      return self.stream_on(idx == 1) ? 1 : 0
    end
    return 0
  end
end

var ov02c10 = OV02C10()
tasmota.add_driver(ov02c10)