# ov02c10.be - hardcoded from Espressif IDF ov02c10_settings.h / ov02c10.c
class CSI_Sensor
  var name
  var wire
  var addr
  static REG_END = 0xFFFF
  static REG_DELAY = 0xEEEE
  def init(name, addr)
    self.name = name
    self.addr = addr
  end
  def write_reg16(reg, val)
    if !self.wire return false end
    self.wire._begin_transmission(self.addr)
    self.wire._write((reg >> 8) & 0xFF)
    self.wire._write(reg & 0xFF)
    self.wire._write(val & 0xFF)
    return self.wire._end_transmission() == 0
  end
  def read_reg16(reg)
    if !self.wire return nil end
    self.wire._begin_transmission(self.addr)
    self.wire._write((reg >> 8) & 0xFF)
    self.wire._write(reg & 0xFF)
    var err = self.wire._end_transmission(false)
    if err != 0 return nil end
    self.wire._request_from(self.addr, 1)
    if self.wire._available()
      return self.wire._read()
    end
    return nil
  end
  def write_array(reg_array, skip_stream_on)
    var i = 0
    var sz = size(reg_array)
    while i < sz
      var reg = reg_array[i][0]
      var val = reg_array[i][1]
      if reg == self.REG_END
        break
      elif reg == self.REG_DELAY
        tasmota.delay(val)
      else
        if !(skip_stream_on && reg == 0x0100 && val == 0x01)
          if !self.write_reg16(reg, val)
            print(format("%s: FAILED at reg 0x%04X", self.name, reg))
            return false
          end
        end
      end
      i += 1
    end
    return true
  end
end

class OV02C10 : CSI_Sensor
  static ADDR = 0x36
  static CHIP_ID = 0x5602
  static MODE_1LANE_1288x728_30 = 0
  static MODE_1LANE_1920x1080_30 = 1
  static MODE_2LANE_1920x1080_30 = 2
  var is_streaming
  var is_initialized
  var width, height
  var mipi_clock
  var format
  var lane_num
  var fps
  var res_index
  var line_sync_enable
  var af_enable
  def init()
    super(self).init("OV02C10", self.ADDR)
    self.is_streaming = false
    self.is_initialized = false
    self.width = 1920
    self.height = 1080
    self.mipi_clock = 408
    self.format = 1
    self.lane_num = 2
    self.fps = 30
    self.res_index = self.MODE_2LANE_1920x1080_30
    self.line_sync_enable = true
    self.af_enable = false
  end
  def detect()
    self.wire = tasmota.wire_scan(self.addr)
    if !self.wire
      print("OV02C10: I2C scan failed")
      return false
    end
    tasmota.delay(10)
    var id_h = self.read_reg16(0x300A)
    var id_l = self.read_reg16(0x300B)
    if id_h == nil || id_l == nil
      print("OV02C10: Chip ID read failed")
      return false
    end
    var chip_id = (id_h << 8) | id_l
    print(format("OV02C10: Chip ID = 0x%04X", chip_id))
    return chip_id == self.CHIP_ID
  end
  def stream_ctrl_val(on)
    if on
      return self.line_sync_enable ? 0x64 : 0x00
    end
    return 0x01
  end
  def stream_on(on)
    if !self.wire return false end
    if on
      if self.is_streaming return true end
      if !self.write_reg16(0x4800, self.stream_ctrl_val(true)) return false end
      if self.af_enable
        if !self.write_reg16(0x3002, 0x01) return false end
        if !self.write_reg16(0x3010, 0x01) return false end
        if !self.write_reg16(0x300D, 0x01) return false end
      end
      if !self.write_reg16(0x0100, 0x01) return false end
      self.is_streaming = true
      return true
    end
    if !self.write_reg16(0x4800, self.stream_ctrl_val(false)) return false end
    if self.af_enable
      if !self.write_reg16(0x3002, 0x00) return false end
      if !self.write_reg16(0x3010, 0x00) return false end
      if !self.write_reg16(0x300D, 0x00) return false end
    end
    if !self.write_reg16(0x0100, 0x00) return false end
    self.is_streaming = false
    return true
  end
  def ov02c10_mipi_reset_regs()
    return [
      [0x0100, 0x00],
      [0x0103, 0x01],
      [self.REG_DELAY, 0x0a],
      [0x4800, 0x01],
      [self.REG_END, 0x00],
    ]
  end
